# Copie para .env (dev). Em prod este arquivo é gerado na VM a partir do Secret Manager.
# Nunca coloque valores reais aqui.

# ---------- Segurança ----------
# Gere com: openssl rand -hex 32
TOKEN=
# Mantenha true: sem isso qualquer um com acesso à porta opera as instâncias
PROTECT_ROUTES=true

# ---------- Aplicação ----------
PORT=3333
# Base dos links de conexão (POST /instance/connect-link). Prod: https://<DOMINIO>
APP_URL=http://localhost:3333
# silent | error | warn | info | debug | trace
LOG_LEVEL=info
RESTORE_SESSIONS_ON_START_UP=true

# ---------- Cliente WhatsApp (Baileys) ----------
CLIENT_PLATFORM='Whatsapp MD'
CLIENT_BROWSER='Chrome'
CLIENT_VERSION='4.0.0'
INSTANCE_MAX_RETRY_QR=10
NATIVE_MOBILE_AUTH=false
MARK_MESSAGES_READ=true

# ---------- MongoDB ----------
# dev: o docker-compose.override.yml já aponta para o container `mongo`
# prod: string do Atlas (usuário só com readWrite no banco whatsapp_api)
MONGODB_ENABLED=true
MONGODB_URL=mongodb://127.0.0.1:27017/whatsapp_api

# ---------- Redis (fila e estado a partir da E4) ----------
REDIS_URL=redis://127.0.0.1:6379

# ---------- Webhook ----------
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_BASE64=false
WEBHOOK_ALLOWED_EVENTS=

# ---------- Somente prod (usados pelo docker compose na VM) ----------
# DOMINIO=<nome>.duckdns.org
# APP_IMAGE=ghcr.io/<owner>/whatsapp-api@sha256:<digest>
